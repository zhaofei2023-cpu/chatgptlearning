{
  "name": "flowspark-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --base=./",
    "preview": "vite preview --host 0.0.0.0",
    "test:permissions": "node tests/permissions.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src tests supabase/functions docs README.md",
    "test:institutions": "node scripts/build-bootstrap.mjs --check && node tests/institutions.mjs",
    "test": "npm run test:permissions && npm run test:institutions && node tests/account-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6"
  }
}
